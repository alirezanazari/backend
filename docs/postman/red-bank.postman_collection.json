              "raw": "{\"context\":{\"requestId\":\"{{$guid}}\",\"account\":null,\"os\":{\"name\":\"Web\",\"version\":\"Postman\"},\"app\":{\"version\":\"1.0.0\",\"buildNumber\":\"100\",\"isRooted\":false,\"language\":\"en-US\",\"theme\":\"dark\"},\"device\":{\"deviceId\":\"{{debugDeviceId}}\",\"model\":\"Postman\",\"fingerprint\":\"debug-postman\"},\"network\":{\"ipAddress\":null,\"connectionType\":\"UNKNOWN\",\"operator\":null}},\"data\":{\"subject\":\"{{debugUserId}}\",\"profileId\":\"{{profileId}}\",\"deviceId\":\"{{debugDeviceId}}\",\"serviceName\":null,\"scopes\":[\"USER\"],\"ttlSeconds\":900}}"
