{
  "info": {
    "_postman_id": "f15d63b0-5e3a-4aa8-9d49-92c2b23b5f8b",
    "name": "red-bank Backend",
    "description": "Postman collection for the API requests currently implemented in the red-bank backend. Public business APIs use the shared context/data envelope. Debug endpoints require the develop profile and REDBANK_DEBUG_ENABLED=true. Gateway key exchange requires REDBANK_GATEWAY_APP_ENCRYPTION_ENABLED=true.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!pm.collectionVariables.get('runSuffix')) {",
          "  pm.collectionVariables.set('runSuffix', Date.now().toString().slice(-6));",
          "}",
          "",
          "const suffix = pm.collectionVariables.get('runSuffix');",
          "const defaults = {",
          "  username: `user${suffix}`,",
          "  password: `Password${suffix}!`,",
          "  nationalId: `10${suffix}`,",
          "  phoneNumber: `0912${suffix}`,",
          "  clientDeviceId: `client-device-${suffix}`,",
          "  deviceFingerprint: `fingerprint-${suffix}`",
          "};",
          "",
          "Object.entries(defaults).forEach(([key, value]) => {",
          "  const existing = pm.collectionVariables.get(key);",
          "  if (!existing || existing.includes('{{runSuffix}}')) {",
          "    pm.collectionVariables.set(key, value);",
          "  }",
          "});"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "let json;",
          "try {",
          "  json = pm.response.json();",
          "} catch (error) {",
          "  json = undefined;",
          "}",
          "",
          "if (json && json.data) {",
          "  const data = json.data;",
          "",
          "  if (data.keyExchangeId) pm.collectionVariables.set('keyExchangeId', data.keyExchangeId);",
          "  if (data.serverPublicKey) pm.collectionVariables.set('serverPublicKey', data.serverPublicKey);",
          "  if (data.userId) pm.collectionVariables.set('userId', data.userId);",
          "  if (data.challengeId) pm.collectionVariables.set('deviceChallengeId', data.challengeId);",
          "  if (data.deviceId) pm.collectionVariables.set('deviceId', data.deviceId);",
          "  if (data.activeProfileId) pm.collectionVariables.set('profileId', data.activeProfileId);",
          "  if (data.profile && data.profile.profileId) pm.collectionVariables.set('profileId', data.profile.profileId);",
          "  if (data.activeProfile && data.activeProfile.profileId) pm.collectionVariables.set('profileId', data.activeProfile.profileId);",
          "  if (data.account && data.account.accountNumber) pm.collectionVariables.set('accountNumber', data.account.accountNumber);",
          "  if (data.account && data.account.iban) pm.collectionVariables.set('iban', data.account.iban);",
          "",
          "  if (data.accessToken) {",
          "    if (pm.info.requestName === 'Debug User Token') {",
          "      pm.collectionVariables.set('accessToken', data.accessToken);",
          "      pm.collectionVariables.set('onboardingToken', data.accessToken);",
          "    } else if (pm.info.requestName === 'Debug Admin Token') {",
          "      pm.collectionVariables.set('adminToken', data.accessToken);",
          "    } else if (pm.info.requestName === 'Debug Service Token') {",
          "      pm.collectionVariables.set('serviceToken', data.accessToken);",
          "    } else if (data.deviceVerificationRequired) {",
          "      pm.collectionVariables.set('deviceVerifyToken', data.accessToken);",
          "    } else if (data.userId && data.accountCompletionStatus === 'ACCOUNT_REQUIRED') {",
          "      pm.collectionVariables.set('onboardingToken', data.accessToken);",
          "    } else {",
          "      pm.collectionVariables.set('accessToken', data.accessToken);",
          "    }",
          "",
          "    if (data.deviceStatus === 'VERIFIED') {",
          "      pm.collectionVariables.set('accessToken', data.accessToken);",
          "    }",
          "  }",
          "}"
        ]
      }
    }
  ],
