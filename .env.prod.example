SPRING_PROFILES_ACTIVE=prod

REDBANK_DEBUG_ENABLED=false
REDBANK_DEBUG_MOCK_OTP_ENABLED=false

REDBANK_JWT_ISSUER=red-bank
REDBANK_JWT_AUDIENCE=red-bank-api
REDBANK_JWT_ACCESS_TOKEN_TTL_SECONDS=900
REDBANK_JWT_PRIVATE_KEY=replace-with-secret-manager-value
REDBANK_JWT_PUBLIC_KEY=replace-with-secret-manager-value

REDBANK_GATEWAY_PUBLIC_BASE_URL=https://api.example.com
REDBANK_GATEWAY_APP_ENCRYPTION_ENABLED=true
REDBANK_GATEWAY_KEY_EXCHANGE_TTL_SECONDS=300

IAM_SERVICE_URL=http://iam-service:8081

IAM_DB_HOST=replace-with-prod-db-host
IAM_DB_PORT=5432
IAM_DB_NAME=iam_db
IAM_DB_USERNAME=replace-with-prod-db-user
IAM_DB_PASSWORD=replace-with-secret-manager-value
