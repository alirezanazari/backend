SPRING_PROFILES_ACTIVE=prod

REDBANK_DEBUG_ENABLED=false
REDBANK_DEBUG_MOCK_OTP_ENABLED=false

REDBANK_JWT_ISSUER=red-bank
REDBANK_JWT_AUDIENCE=red-bank-api
REDBANK_JWT_ACCESS_TOKEN_TTL_SECONDS=900
REDBANK_JWT_ONBOARDING_TOKEN_TTL_SECONDS=300
REDBANK_JWT_SIGNING_SECRET=replace-with-secret-manager-value
REDBANK_JWT_PRIVATE_KEY=replace-with-secret-manager-value
REDBANK_JWT_PUBLIC_KEY=replace-with-secret-manager-value

REDBANK_GATEWAY_PUBLIC_BASE_URL=https://api.example.com
REDBANK_GATEWAY_APP_ENCRYPTION_ENABLED=true
REDBANK_GATEWAY_KEY_EXCHANGE_TTL_SECONDS=300

IAM_SERVICE_URL=http://iam-service:8081
ACCOUNT_SERVICE_URL=http://account-service:8082

IAM_DB_HOST=replace-with-prod-db-host
IAM_DB_PORT=5432
IAM_DB_NAME=iam_db
IAM_DB_USERNAME=replace-with-prod-db-user
IAM_DB_PASSWORD=replace-with-secret-manager-value

ACCOUNT_DB_HOST=replace-with-prod-db-host
ACCOUNT_DB_PORT=5432
ACCOUNT_DB_NAME=account_db
ACCOUNT_DB_USERNAME=replace-with-prod-db-user
ACCOUNT_DB_PASSWORD=replace-with-secret-manager-value

REDBANK_ACCOUNT_DEFAULT_CURRENCY=IRR
REDBANK_ACCOUNT_IBAN_COUNTRY_CODE=IR
REDBANK_ACCOUNT_BANK_CODE=0620
REDBANK_ACCOUNT_ALLOWED_JOB_IDS=replace-with-kyc-backed-job-list-or-service

REDBANK_OTP_TTL_SECONDS=300
REDBANK_OTP_MAX_ATTEMPTS=5
