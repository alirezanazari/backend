{
  "index_patterns": [
    "otel-v1-apm-span-*"
  ],
  "priority": 500,
  "template": {
    "settings": {
      "index.number_of_shards": "1",
      "index.number_of_replicas": "0",
      "index.refresh_interval": "5s",
      "index.mapping.total_fields.limit": "1000",
      "plugins.index_state_management.policy_id": "redbank-develop-traces-policy"
    },
    "mappings": {
      "dynamic": true,
      "date_detection": false,
      "dynamic_templates": [
        {
          "strings_as_keywords": {
            "match_mapping_type": "string",
            "mapping": {
              "type": "keyword",
              "ignore_above": 1024
            }
          }
        }
      ],
      "properties": {
        "traceId": {
          "type": "keyword"
        },
        "spanId": {
          "type": "keyword"
        },
        "parentSpanId": {
          "type": "keyword"
        },
        "name": {
          "type": "keyword"
        },
        "kind": {
          "type": "keyword"
        },
        "serviceName": {
          "type": "keyword"
        },
        "startTime": {
          "type": "date"
        },
        "endTime": {
          "type": "date"
        },
        "durationInNanos": {
          "type": "long"
        },
        "status": {
          "properties": {
            "code": {
              "type": "keyword"
            },
            "message": {
              "type": "match_only_text"
            }
          }
        },
        "attributes": {
          "type": "object",
          "enabled": true
        },
        "resource": {
          "type": "object",
          "enabled": true
        }
      }
    }
  },
  "_meta": {
    "owner": "redbank",
    "environment": "develop",
    "data_class": "trace_spans"
  }
}
