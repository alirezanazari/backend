{
  "type": "monitor",
  "name": "redbank-debug-log-develop",
  "monitor_type": "query_level_monitor",
  "enabled": true,
  "schedule": {
    "period": {
      "interval": 1,
      "unit": "MINUTES"
    }
  },
  "inputs": [
    {
      "search": {
        "indices": [
          "logs-redbank.*-develop-*"
        ],
        "query": {
          "size": 0,
          "query": {
            "bool": {
              "filter": [
                {
                  "range": {
                    "@timestamp": {
                      "gte": "{{period_end}}||-5m",
                      "lte": "{{period_end}}",
                      "format": "epoch_millis"
                    }
                  }
                },
                {
                  "term": {
                    "log.level": "DEBUG"
                  }
                }
              ]
            }
          },
          "aggregations": {
            "services": {
              "terms": {
                "field": "service.name",
                "size": 10
              }
            }
          }
        }
      }
    }
  ],
  "triggers": [
    {
      "name": "DEBUG log emitted",
      "severity": "3",
      "condition": {
        "script": {
          "source": "ctx.results[0].hits.total.value > 0",
          "lang": "painless"
        }
      },
      "actions": []
    }
  ]
}
