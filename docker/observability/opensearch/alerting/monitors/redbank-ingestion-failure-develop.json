{
  "type": "monitor",
  "name": "redbank-ingestion-failure-develop",
  "monitor_type": "query_level_monitor",
  "enabled": true,
  "schedule": {
    "period": {
      "interval": 1,
      "unit": "MINUTES"
    }
  },
  "inputs": [
    {
      "search": {
        "indices": [
          "deadletter-redbank.*"
        ],
        "query": {
          "size": 0,
          "query": {
            "range": {
              "@timestamp": {
                "gte": "{{period_end}}||-5m",
                "lte": "{{period_end}}",
                "format": "epoch_millis"
              }
            }
          },
          "aggregations": {
            "pipelines": {
              "terms": {
                "field": "redbank.ingestion_pipeline",
                "missing": "unknown",
                "size": 10
              }
            }
          }
        }
      }
    }
  ],
  "triggers": [
    {
      "name": "Dead-letter documents detected",
      "severity": "1",
      "condition": {
        "script": {
          "source": "ctx.results[0].hits.total.value > 0",
          "lang": "painless"
        }
      },
      "actions": []
    }
  ]
}
