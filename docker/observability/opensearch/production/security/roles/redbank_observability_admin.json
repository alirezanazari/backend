{
  "cluster_permissions": [
    "cluster_composite_ops",
    "cluster_monitor",
    "indices_monitor",
    "manage_index_templates",
    "cluster:admin/opendistro/ism/*",
    "cluster:admin/opensearch/alerting/*",
    "cluster:admin/opensearch/notifications/*"
  ],
  "index_permissions": [
    {
      "index_patterns": [
        "logs-redbank.*-prod-*",
        "deadletter-redbank.prod-*",
        "metrics-redbank.prod-*",
        "otel-v1-apm-span-*",
        "otel-v1-apm-service-map-*",
        "redbank-observability-assets-*",
        ".kibana*",
        ".opensearch-observability*",
        ".opensearch-alerting-*",
        ".opendistro-alerting-*"
      ],
      "dls": "",
      "fls": [],
      "masked_fields": [],
      "allowed_actions": [
        "read",
        "write",
        "create_index",
        "manage",
        "indices_monitor"
      ]
    }
  ],
  "tenant_permissions": [
    {
      "tenant_patterns": [
        "global_tenant"
      ],
      "allowed_actions": [
        "kibana_all_write"
      ]
    }
  ]
}
